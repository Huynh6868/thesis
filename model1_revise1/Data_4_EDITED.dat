  2, 9, 5, 8, 3, 1, 10, 4, 6, 7,
  7, 1, 6, 4, 9, 10, 5, 8, 2, 3
]; //index 1 = patient 1 -> surgery type 1; index 2 = patient 2 -> surgery type 2; index 11 = patient 11 -> surrgery type 1.

